0-14\ntags:\n  - \u6807\u7b7e1\nstatus: \u5b66\u4e60\u4e2d\nreview: 2026-10-21\n---\n</code></pre> <ol> <li>\u56de\u5230\u672c\u9875\uff0c\u5728\u5bf9\u5e94\u5206\u7ec4\u4e0b\u52a0\u4e00\u884c\u94fe\u63a5</li> <li>\u5728 <code>mkdocs.yml</code> \u7684 <code>nav:</code> \u91cc\u52a0\u4e00\u884c</li> <li><code>mkdocs serve</code> \u9884\u89c8 \u2192 <code>mkdocs gh-deploy</code> \u53d1\u5e03</li> </ol>"},{"location":"notes/2026-10-14-stm32-gpio/","title":"STM32 GPIO \u516b\u79cd\u8f93\u51fa\u6a21\u5f0f","text":"<p>\u8fd9\u662f\u6837\u4f8b\u7b14\u8bb0\uff0c\u5c55\u793a\u63a8\u8350\u7684\u7ed3\u6784\u3002\u7167\u7740\u6539\u5c31\u80fd\u7528\uff0c\u4e0d\u9700\u8981\u4fdd\u7559\u672c\u9875\u3002</p>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_1","title":"\u4e00\u53e5\u8bdd\u7ed3\u8bba","text":"<p>GPIO \u7684\u516b\u79cd\u6a21\u5f0f\u7531 <code>CRL</code> / <code>CRH</code> \u4e24\u4e2a\u5bc4\u5b58\u5668\u91cc\u6bcf 4 \u4f4d\u4e00\u7ec4\u7684 <code>MODE[1:0]</code> + <code>CNF[1:0]</code> \u51b3\u5b9a\u3002</p>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_2","title":"\u539f\u7406","text":"<p>\u6bcf\u4e2a\u5f15\u811a\u5728\u914d\u7f6e\u5bc4\u5b58\u5668\u91cc\u5360 4 \u4e2a bit\uff1a</p> \u4f4d \u540d\u79f0 \u4f5c\u7528 <code>MODE1:0</code> \u8f93\u51fa\u901f\u5ea6 / \u8f93\u5165\u4fdd\u7559 <code>00</code> \u8f93\u5165\uff0c<code>01</code> 10MHz\uff0c<code>10</code> 2MHz\uff0c<code>11</code> 50MHz <code>CNF1:0</code> \u914d\u7f6e\u4f4d \u914d\u5408 MODE \u51b3\u5b9a\u5177\u4f53\u6a21\u5f0f <p>\u516b\u79cd\u6a21\u5f0f\u901f\u67e5\uff1a</p> CNF MODE=00\uff08\u8f93\u5165\uff09 MODE\u226000\uff08\u8f93\u51fa\uff09 <code>00</code> \u6a21\u62df\u8f93\u5165 \u901a\u7528\u63a8\u633d\u8f93\u51fa <code>01</code> \u6d6e\u7a7a\u8f93\u5165 \u901a\u7528\u5f00\u6f0f\u8f93\u51fa <code>10</code> \u4e0a\u62c9/\u4e0b\u62c9\u8f93\u5165 \u590d\u7528\u63a8\u633d\u8f93\u51fa <code>11</code> \u4fdd\u7559 \u590d\u7528\u5f00\u6f0f\u8f93\u51fa","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_3","title":"\u4ee3\u7801\u7247\u6bb5","text":"<pre><code>/* \u628a PA0 \u914d\u6210 50MHz \u63a8\u633d\u8f93\u51fa\uff1aCNF=00, MODE=11 \u2192 0x3 */\nGPIOA-&gt;CRL &amp;= ~(0xF &lt;&lt; 0);   /* \u5148\u6e05\u7a7a\u4f4e 4 \u4f4d */\nGPIOA-&gt;CRL |=  (0x3 &lt;&lt; 0);   /* \u518d\u5199\u5165 0011 */\n</code></pre>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_4","title":"\u8e29\u5751\u8bb0\u5f55","text":"<p>LED \u4e0d\u4eae\u7684\u7b2c\u4e00\u5acc\u7591</p> <p>\u63a8\u633d\u8f93\u51fa\u6ca1\u95ee\u9898\uff0c\u4f46\u5fd8\u4e86\u4f7f\u80fd\u65f6\u949f\uff1a</p> <pre><code>RCC-&gt;APB2ENR |= 0x04;   /* \u4f7f\u80fd GPIOA \u65f6\u949f */\n</code></pre> <p>\u6ca1\u6709\u65f6\u949f\uff0c\u5bc4\u5b58\u5668\u5199\u4e86\u4e5f\u4e0d\u751f\u6548\u2014\u2014\u5916\u8bbe\u6839\u672c\u6ca1\u901a\u7535\u3002</p>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_5","title":"\u81ea\u6d4b","text":"<ol> <li>\u4e3a\u4ec0\u4e48\u914d\u8f93\u51fa\u524d\u8981\u5148 <code>&amp;= ~(...)</code> \u6e05\u4f4d\uff0c\u800c\u4e0d\u662f\u76f4\u63a5 <code>|=</code>\uff1f</li> <li>\u5f00\u6f0f\u8f93\u51fa\u63a5\u4e0a\u62c9\u7535\u963b\uff0c\u548c\u63a8\u633d\u8f93\u51fa\u9a71\u52a8\u540c\u4e00\u4e2a LED\uff0c\u6ce2\u5f62\u6709\u4ec0\u4e48\u4e0d\u540c\uff1f</li> </ol>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"notes/2026-10-14-stm32-gpio/#_6","title":"\u76f8\u5173","text":"<ul> <li>\u5b66\u4e60\u7b14\u8bb0\u603b\u89c8</li> </ul>","tags":["STM32","\u5bc4\u5b58\u5668"]},{"location":"projects/","title":"\u5b66\u4e60\u6210\u679c\u5c55\u793a","text":"<p><code>notes/</code> \u8bb0\u7684\u662f\u8fc7\u7a0b\u548c\u77e5\u8bc6\u70b9\uff0c\u8fd9\u91cc\u653e\u7684\u662f\u505a\u51fa\u6765\u7684\u4e1c\u897f\uff1a \u80fd\u8dd1\u7684\u7a0b\u5e8f\u3001\u80fd\u4eae\u7684\u677f\u5b50\u3001\u5199\u5b8c\u7684\u62a5\u544a\u3002\u76ee\u6807\u6